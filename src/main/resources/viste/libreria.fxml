<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.univq.controller.LibreriaController">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="45.0" prefWidth="600.0" spacing="15.0">
         <children>
            <Label prefHeight="35.0" prefWidth="273.0" text="  📚 Libreria Musicale" textFill="#ebb946">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="labelStatoSelezione" prefHeight="20.0" prefWidth="236.0" text="Seleziona un artista per iniziare" textFill="#888888">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <SplitPane dividerPositions="0.2828854314002829, 0.6393210749646393" prefHeight="343.0" prefWidth="709.0" VBox.vgrow="ALWAYS">
         <items>
            <TableView fx:id="tabellaArtisti" fixedCellSize="35.0" prefHeight="341.0" prefWidth="508.0">
              <columns>
                <TableColumn fx:id="colonnaArtisti" prefWidth="376.0" text="Artisti" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <TableView fx:id="tabellaAlbum" fixedCellSize="35.0" prefHeight="341.0" prefWidth="508.0">
               <columns>
                  <TableColumn fx:id="colonnaAlbum" prefWidth="218.0" text="Album" />
                  <TableColumn fx:id="colonnaPlayAlbum" maxWidth="60.0" minWidth="40.0" prefWidth="40.0" resizable="false" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <TableView fx:id="tabellaBrani" fixedCellSize="35.0" prefHeight="341.0" prefWidth="508.0">
               <columns>
                  <TableColumn fx:id="colonnaBrani" prefWidth="227.0" text="Brani" />
                  <TableColumn fx:id="colonnaPlayBrano" maxWidth="60.0" minWidth="40.0" prefWidth="40.0" resizable="false" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </items>
      </SplitPane>
   </children>
</VBox>
